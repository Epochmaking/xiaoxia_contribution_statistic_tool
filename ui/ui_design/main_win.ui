                  <property name="styleSheet">
                   <string notr="true">QCheckBox {
    font-size: 12px;
    color: #333333;
    spacing: 8px; /* 方框和文字间距 */
}
/* 复选框方框基础 */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 3px solid #666666;
    border-radius: 4px; /* 圆角方框 */
    border-color: rgb(212, 212, 212);
    background-color: white;
}
/* 鼠标悬浮未选中 */
QCheckBox::indicator:hover {
    border-color: rgb(6, 173, 86);
}
/* 选中状态：绿色背景+绿色边框，原生白色对勾自动出现 */
QCheckBox::indicator:checked {
    border-color: rgb(6, 173, 86);
    background-color: rgb(6, 173, 86);
    /* 替换image，使用Qt内置勾选符号，白色 */
    border-image: none;
    image: url(&quot;:/images/checkmark_white&quot;);
}
</string>
